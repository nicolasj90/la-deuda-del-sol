resource_name = "odila_la_forastera"
script = ExtResource("1_ng47u")
id = "odila_la_forastera"
nombre = "Odila, la Forastera"
texto = "De palabra: refrendá — devolvé al Estrado con Sello el último Fiador aliado caído. Letra chica: vuelve a tu mano como la Forastera (4/2, Al contado, sin Letra chica)."
lore = "la heredera solemne y su doble vida. Dos cartas, una persona, ningún acta."
