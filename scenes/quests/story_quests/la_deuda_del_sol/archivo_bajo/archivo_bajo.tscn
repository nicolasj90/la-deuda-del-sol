[node name="CartelLevante" parent="OnTheGround" instance=ExtResource("8_sign")]
position = Vector2(640, 864)
text = "ODILA: Al levante primero. Siempre primero al levante. Profundo."

[node name="CartelLetra" parent="OnTheGround" instance=ExtResource("8_sign")]
position = Vector2(960, 864)
text = "ODILA: Después la letra: corra los anaqueles, que la mirada pase entre ellos sin tocarlos."

[node name="CartelEstrado" parent="OnTheGround" instance=ExtResource("8_sign")]
position = Vector2(1280, 864)
text = "ODILA: Al final, el estrado. Todo en esta casa termina en el estrado."

