[node name="LapidaGrabada" type="Node2D"]
editor_description = "Piedra nueva de Cosme. Sin leer, los renglones del grabado están en bruto; leída se le marca la cinta de constancia y, si le faltaba una letra, Cosme talla la enmienda. El texto del grabado y el rótulo de estado sólo aparecen cuando el jugador está frente a la piedra: si no, los «Aquí descansa…» de dos piedras vecinas se pisan entre sí."
script = ExtResource("1_lapida")

